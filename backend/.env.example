# The API this backend serves is identical to the Java implementation's; see openapi.json.
SERVER_PORT=9200

DB_HOST=localhost
DB_PORT=5433
DB_NAME=portfolio_node
DB_USER=portfolio
DB_PASSWORD=portfolio

REDIS_HOST=localhost
REDIS_PORT=6379

# The merged frontend runs on one origin now, not two. Add every origin that will call this API —
# no wildcard: this API issues JWTs and sets a refresh cookie, so the allow-list is the boundary.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://my-portfolio-frontend-bay.vercel.app

# The refresh cookie. Locally the frontend and API are same-site, so the strictest setting works.
# When the frontend is on its own domain (Vercel) every call is cross-site and the browser will
# only send the cookie with SameSite=None — which it in turn only accepts over HTTPS:
#   COOKIE_SECURE=true
#   COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# No working default in production, deliberately: openssl rand -base64 48
# JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# Provisions the single admin on first start when none exists.
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=dev-only-password

# Where uploaded bytes go. LOCAL writes under MEDIA_STORAGE_ROOT and is fine for development.
#
# Any deployment whose filesystem is ephemeral — Render, Fly, Heroku, most container platforms —
# MUST use OBJECT_STORAGE (D-042). With LOCAL there, every deploy silently discards every upload
# while the database rows keep pointing at them, so the site serves broken images to everyone
# whose browser has not cached them.
#
# The four S3_* values work against any S3-compatible provider; only the endpoint and region
# differ:
#   Cloudflare R2   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   S3_REGION=auto
#   Backblaze B2    S3_ENDPOINT=https://s3.<region>.backblazeb2.com             S3_REGION=<region>
#   AWS S3          leave S3_ENDPOINT empty                                     S3_REGION=<region>
#   MinIO (local)   S3_ENDPOINT=http://localhost:9000                           S3_REGION=us-east-1
MEDIA_STORAGE_BACKEND=LOCAL
MEDIA_STORAGE_ROOT=./data/media

# Placeholders, left in plain sight rather than commented out so the set is obvious and nothing is
# missed when filling them in. They are inert while MEDIA_STORAGE_BACKEND=LOCAL — nothing reads
# them — and the real values belong ONLY in the platform's environment settings, never in a file in
# this repository. Note that S3_ENDPOINT is the host on its own: the bucket goes in S3_BUCKET, and
# Cloudflare's dashboard shows the endpoint with the bucket name appended, which must be removed.
S3_BUCKET=portfolio-media
S3_ENDPOINT=https://REPLACE-WITH-ACCOUNT-ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=REPLACE-WITH-R2-ACCESS-KEY-ID
S3_SECRET_ACCESS_KEY=REPLACE-WITH-R2-SECRET-ACCESS-KEY
# Path-style addressing; true suits a custom endpoint (R2, B2, MinIO), false suits AWS itself.
S3_FORCE_PATH_STYLE=true
