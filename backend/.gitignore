# Build output — regenerated by `npm run build` on every deploy.
dist/

# Dependencies. NOTE: node_modules is currently *tracked* in this repo (committed earlier), so
# this rule does not untrack it. To stop carrying ~3.7k vendor files:
#   git rm -r --cached backend/node_modules && git commit -m "Stop tracking node_modules"
node_modules/

# Local env. Also currently tracked, and holding only development values — but the moment a real
# secret goes in, it would be committed. Keep secrets in the host's environment instead.
# .env
.env
data/media/
